{
       "$schema": "https://openapi.vercel.sh/vercel.json",
       "version": 2,
       "builds": [
              {
                     "src": "app.js",
                     "use": "@vercel/node"
              }
       ],
       "functions": {
              "app.js": {
                     "includeFiles": "etc/system_promt.md"
              }
       },
       "routes": [
              {
                     "src": "/(.*)",
                     "dest": "app.js"
              }
       ]
}